# Copy to deploy/.env, then fill locally. Never commit deploy/.env.
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_LOGIN=
# At least 12 characters
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Optional SMS provider credentials for real OTP; no test bypass in production.
SMS_PROVIDER=smsaero
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_SIGN=
