# Backend API env template — copy to /opt/koroli-dorog-api/.env on VPS.
# Never commit real values. Names only — fill on the host.

NODE_ENV=production
PORT=3000
APP_VERSION=1.1.4+6

# JWT / admin
JWT_SECRET=
ADMIN_JWT_SECRET=
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_JWT_EXPIRES_IN=12h
# ADMIN_IP_ALLOWLIST=

# Redis / KV
KV_BACKEND=redis
REDIS_URL=
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# CORS / body
# CORS_ORIGINS=https://your-admin-host,https://your-app
# TRUST_PROXY=loopback
BODY_LIMIT=30mb

# OTP / SMS — production: real provider, debug off
OTP_DEBUG_LOG=0
OTP_TTL_SEC=300
OTP_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
# SMSAERO_EMAIL=
# SMSAERO_API_KEY=
# SMSAERO_SIGN=
# SMSC_LOGIN=
# SMSC_PASSWORD=
# DEMO_OTP_PHONE=
# DEMO_OTP_CODE=
# TEST_OTP_PHONE=
# TEST_OTP_CODE=

# FCM
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/koroli-dorog-api/firebase-sa.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Payments (provider secrets stay on server)
# PAYMENT_PROVIDER=
# PAYMENT_SHOP_ID=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Observability
LOG_FORMAT=json
LOG_LEVEL=log
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
