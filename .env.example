# Root Flutter dart-defines mirror (passenger + driver).
# Copy to keys.local.env (preferred) or export as CI secrets.
# Do NOT put real secrets in git. See keys.local.env.example and docs/KEYS_CHECKLIST.md.

MAPKIT_API_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_GEOSUGGEST_KEY=
YANDEX_ROUTING_KEY=
YANDEX_ROUTE_DETAILS_KEY=
YANDEX_DISTANCE_MATRIX_KEY=
USE_YANDEX_MAPKIT=false

API_BASE_URL=https://your-api-host.example
USE_MOCK_API=false

FIREBASE_ENABLED=false
PAYMENT_URL=

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
CRASHLYTICS_ENABLED=false

ENABLE_AVATAR_UPLOAD=false
