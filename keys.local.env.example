# Скопируйте в keys.local.env и вставьте свои ключи.
# keys.local.env в .gitignore — в git не попадёт.
# Скрипты run_with_keys.ps1 / build_release.ps1 читают непустые строки → --dart-define=KEY=VALUE

# --- Maps / Geo (Yandex) ---
MAPKIT_API_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_GEOSUGGEST_KEY=
# Routing: опционально — без ключа цена считается локально (haversine × 1.35)
YANDEX_ROUTING_KEY=
YANDEX_ROUTE_DETAILS_KEY=
YANDEX_DISTANCE_MATRIX_KEY=
USE_YANDEX_MAPKIT=false

# --- API (production: USE_MOCK_API=false) ---
API_BASE_URL=http://161.104.19.23
USE_MOCK_API=false

# --- Push / FCM ---
# Положите google-services.json / GoogleService-Info.plist (см. docs/PUSH_SETUP.md).
# build_release.ps1 ставит FIREBASE_ENABLED=true если json найден.
FIREBASE_ENABLED=false

# --- Payments (server-driven; legacy URL optional) ---
# Реальный checkout URL/ключи — на backend. Клиент читает /api/payments/config.
# PAYMENT_URL оставляйте пустым, если эквайер только на сервере.
PAYMENT_URL=

# --- Observability (см. docs/MONITORING.md) ---
# Sentry: DSN из sentry.io; без значения stub no-op.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# CRASHLYTICS_ENABLED=true только при Firebase + пакете firebase_crashlytics
CRASHLYTICS_ENABLED=false

# --- Feature flags (клиент) ---
# ENABLE_AVATAR_UPLOAD=true когда backend принимает аватар
ENABLE_AVATAR_UPLOAD=false

# --- Backend (VPS /opt/koroli-dorog-api/.env) — НЕ для --dart-define ---
# Скопируйте шаблон backend/api/.env.example на сервер.
# SMS: SMSAERO_* / SMSC_*
# FCM: FIREBASE_SERVICE_ACCOUNT_JSON=... или FIREBASE_SERVICE_ACCOUNT_PATH=...
# OTP_DEBUG_LOG=0 в production
